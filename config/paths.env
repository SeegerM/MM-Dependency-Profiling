# Paths used by every script. Relative values are taken against the repository root.
#
# To use other locations, do not edit this file: create config/paths.local.env (gitignored) with
# the lines you want to change, or set the variable in the environment for one run. Windows paths
# are written with forward slashes (F:/data), never as /f/data, because java.exe receives them.
# Shell scripts read this through config/env.sh, Python through experiments/lib/paths.py.

# Algorithm checkouts: git submodules pinned to exact commits. Build with ./run.sh build-upstream.
SPIND_HOME=upstream/spind
HYFD_HOME=upstream/HyFD
HYUCC_HOME=upstream/HyUCC

# The Polypheny benchmarking client, whose `coms` scenario is MMSBench-Net. Optional: only the
# MMSBench-Net loader and export need it, and the build skips them when it is not built.
POLY_HOME=upstream/Polypheny-Simple-Client

# Source corpora (TPC-H dbgen output, IMDB and MusicBrainz dumps, ...). See REPRODUCE.md.
DATA_ROOT=data

# Scratch: generated datasets, meta-level exports, discovery output. Tens of GB for the full corpora.
WORK_ROOT=work

# Canonical result dumps and per-run metadata of the discovery runs.
RESULT_ROOT=work/runs
