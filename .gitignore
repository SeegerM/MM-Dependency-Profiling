# Machine-local configuration (templates: config/*.example, config/paths.env)
config/paths.local.env
connections.properties

# Data, scratch and results are regenerated by the pipeline and never committed.
# data/ holds the source corpora, work/ everything derived from them (config/paths.env).
/data/
/work/
/results/
/tmp/

# The manuscript is maintained in Overleaf; report scripts still write paper/tables/ locally.
/paper/

# Internal notes (submission planning, open problems) that are not part of the artifact
/private/

# Local checkouts that are not part of the artifact
/upstream/m2bench/

# Build output
__pycache__/
*.pyc
target/
out/
build/
*.class
.cp-*.txt
cp.txt

# Not part of the published artifact: working notes, earlier experiments, and a stray file
/docs/
/archive/
/paper.tex
