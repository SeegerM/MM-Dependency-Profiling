{
 "name": "imdb-full",
 "source": "IMDB",
 "comment": [
  "Generated by experiments/datasets/gen_imdb_spec.py -- do not edit by hand.",
  "Tables up to 2500 MB are taken whole, so no sampling can turn an exact",
  "foreign key into a partial one. IMDB ships no machine-readable foreign-key list; the",
  "keys come from IMDb's published dataset documentation and are transcribed in the",
  "generator, where they can be read and checked."
 ],
 "format": {
  "delimiter": "\t",
  "nulls": [
   "\\N"
  ],
  "header": true,
  "suffix": ".csv"
 },
 "anchor": {
  "table": "basics",
  "key": "tconst",
  "rows": 0,
  "note": "unused: every table is taken whole"
 },
 "tables": {
  "basics": {
   "store": "graph",
   "relation": "neo4j:Title",
   "columns": [
    "tconst",
    "titleType",
    "primaryTitle",
    "originalTitle",
    "isAdult",
    "startYear",
    "endYear",
    "runtimeMinutes",
    "genres"
   ],
   "arrays": {
    "genres": {
     "split": ","
    }
   }
  },
  "cew": {
   "store": "graph",
   "relation": "neo4j:Crew",
   "columns": [
    "tconst",
    "directors",
    "writers"
   ],
   "arrays": {
    "directors": {
     "split": ","
    },
    "writers": {
     "split": ","
    }
   }
  },
  "episode": {
   "store": "graph",
   "relation": "neo4j:Episode",
   "columns": [
    "tconst",
    "parentTconst",
    "seasonNumber",
    "episodeNumber"
   ]
  },
  "name": {
   "store": "document",
   "relation": "mongo.person",
   "columns": [
    "nconst",
    "primaryName",
    "birthYear",
    "deathYear",
    "primaryProfession",
    "knownForTitles"
   ],
   "arrays": {
    "primaryProfession": {
     "split": ","
    },
    "knownForTitles": {
     "split": ","
    }
   }
  },
  "rating": {
   "store": "relational",
   "relation": "pg.title_rating",
   "columns": [
    "tconst",
    "averageRating",
    "numVotes"
   ]
  },
  "akas": {
   "store": "relational",
   "relation": "pg.title_akas",
   "columns": [
    "titleId",
    "ordering",
    "title",
    "region",
    "language",
    "types",
    "attributes",
    "isOriginalTitle"
   ]
  },
  "principals": {
   "store": "relational",
   "relation": "pg.title_principals",
   "columns": [
    "tconst",
    "ordering",
    "nconst",
    "category",
    "job",
    "characters"
   ]
  }
 },
 "dependencies": [
  {
   "dependent": "neo4j:Crew.tconst",
   "referenced": "neo4j:Title.tconst",
   "models": "graph -> graph",
   "cross_model": false,
   "collection_valued": false
  },
  {
   "dependent": "neo4j:Crew@directors.directors",
   "referenced": "mongo.person.nconst",
   "models": "graph -> document",
   "cross_model": true,
   "collection_valued": true
  },
  {
   "dependent": "neo4j:Crew@writers.writers",
   "referenced": "mongo.person.nconst",
   "models": "graph -> document",
   "cross_model": true,
   "collection_valued": true
  },
  {
   "dependent": "neo4j:Episode.tconst",
   "referenced": "neo4j:Title.tconst",
   "models": "graph -> graph",
   "cross_model": false,
   "collection_valued": false
  },
  {
   "dependent": "neo4j:Episode.parentTconst",
   "referenced": "neo4j:Title.tconst",
   "models": "graph -> graph",
   "cross_model": false,
   "collection_valued": false
  },
  {
   "dependent": "pg.title_rating.tconst",
   "referenced": "neo4j:Title.tconst",
   "models": "relational -> graph",
   "cross_model": true,
   "collection_valued": false
  },
  {
   "dependent": "pg.title_akas.titleId",
   "referenced": "neo4j:Title.tconst",
   "models": "relational -> graph",
   "cross_model": true,
   "collection_valued": false
  },
  {
   "dependent": "pg.title_principals.tconst",
   "referenced": "neo4j:Title.tconst",
   "models": "relational -> graph",
   "cross_model": true,
   "collection_valued": false
  },
  {
   "dependent": "pg.title_principals.nconst",
   "referenced": "mongo.person.nconst",
   "models": "relational -> document",
   "cross_model": true,
   "collection_valued": false
  },
  {
   "dependent": "mongo.person@knownForTitles.knownForTitles",
   "referenced": "neo4j:Title.tconst",
   "models": "document -> graph",
   "cross_model": true,
   "collection_valued": true
  }
 ]
}
